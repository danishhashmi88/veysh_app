<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">

        <!-- Splash background -->
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>

        <!-- Use App Logo -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/transparent_pixel</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#FFFFFF</item>

        <!-- Keep animation duration valid -->
        <item name="android:windowSplashScreenAnimationDuration">1000</item>

        <!-- Maintain windowBackground for compatibility -->
        <item name="android:windowBackground">@drawable/launch_screen</item>

    </style>

</resources>

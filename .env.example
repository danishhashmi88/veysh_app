# Copy this file to `.env` (production) or `.env.staging` (staging).
# Native rebuild is required after changing values:
# Android: ENVFILE=.env npm run android
# iOS:     ENVFILE=.env npm run ios

APP_ENV=production

# API
API_BASE_URL=https://api.veysh.com/webservice/api/v1
IMAGE_BASE_URL=https://api.veysh.com/
SOCKET_URL=https://api.veysh.com/

# Website / sharing / deep links
SHARE_BASE_URL=https://veysh.com
DEEP_LINK_SCHEME=veysh
LINKING_PREFIXES=veysh://,https://veysh.com

# Google Sign-In (Web client_type: 3 + iOS client)
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# In-app purchases
IOS_IAP_PRODUCT_ID=premium_subscription
ANDROID_IAP_PRODUCT_ID=premium_subscription
ANDROID_IAP_BASE_PLAN_ID=monthy-subscription-99

# Legal
APPLE_EULA_URL=https://www.apple.com/legal/internet-services/itunes/dev/stdeula/
